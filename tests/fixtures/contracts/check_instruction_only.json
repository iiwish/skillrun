{
  "command": "check",
  "ok": false,
  "cwd": "<capsule>",
  "status": "instruction-only",
  "manifest": {
    "path": ".skillrun/manifest.generated.yaml",
    "present": false,
    "freshness": "missing"
  },
  "files": {
    "skill": true,
    "python_action": false,
    "node_action": false,
    "typescript": false,
    "config": false
  },
  "runtime": {
    "adapter": null,
    "entrypoint": null
  },
  "requirements": {
    "present": false,
    "executable": null,
    "packages": []
  },
  "dependency_checks": [],
  "host_diagnostics": {
    "scope": "current host environment",
    "path_env": {
      "name": "PATH",
      "present": true,
      "entries": "<path_entries>"
    },
    "dependency_probes": "runtime version/package import/path lookup only",
    "docker_required": false,
    "auto_install": false,
    "action_execution": false
  },
  "source_checks": [],
  "example_checks": [
    {
      "path": "examples/default.input.json",
      "present": false
    }
  ],
  "reason": "SkillRun does not infer actions from Markdown, scripts, references, assets, or examples.",
  "next_step": "Add action.py or action.mjs, then run `skillrun manifest --cwd <capsule>`.",
  "note": "readiness reads Manifest, files, hashes and host dependency probes only; it does not run or import action source, install dependencies, or require Docker."
}
