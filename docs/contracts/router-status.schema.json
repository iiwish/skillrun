{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillrun.local/schemas/router-status.v1.schema.json",
  "title": "SkillRun Router status contract",
  "type": "object",
  "required": [
    "command",
    "schema_version",
    "ok",
    "router",
    "tools",
    "resources",
    "routes",
    "issues",
    "error"
  ],
  "properties": {
    "command": {
      "const": "router status"
    },
    "schema_version": {
      "const": "router.status.v1"
    },
    "ok": {
      "type": "boolean"
    },
    "router": {
      "type": "object",
      "required": ["snapshot", "capsules"],
      "properties": {
        "snapshot": {
          "const": true
        },
        "capsules": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capsule_id", "capsule_path", "name", "manifest_sha256"],
        "properties": {
          "capsule_id": {
            "type": "string"
          },
          "capsule_path": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        },
        "additionalProperties": true
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capsule_id", "uri_prefix"],
        "properties": {
          "capsule_id": {
            "type": "string"
          },
          "uri_prefix": {
            "type": "string",
            "pattern": "^skillrun://router/"
          }
        },
        "additionalProperties": true
      }
    },
    "routes": {
      "type": "array",
      "description": "Per enabled-capsule Router diagnostics. Disabled capsules are intentionally omitted.",
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "issues": {
      "type": "array",
      "description": "Machine-readable warnings and errors for enabled capsules considered by the Router.",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    }
  },
  "$defs": {
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "issue": {
      "type": "object",
      "required": ["code", "severity", "message", "recommended_action"],
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "enum": ["warning", "error"]
        },
        "message": {
          "type": "string"
        },
        "capsule_id": {
          "type": ["string", "null"]
        },
        "tool_name": {
          "type": ["string", "null"]
        },
        "recommended_action": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "route": {
      "type": "object",
      "required": [
        "capsule_id",
        "capsule_path",
        "enabled",
        "state",
        "readiness_status",
        "recommended_action"
      ],
      "properties": {
        "capsule_id": {
          "type": "string"
        },
        "capsule_path": {
          "type": "string"
        },
        "enabled": {
          "const": true
        },
        "state": {
          "enum": ["routable", "blocked"]
        },
        "readiness_status": {
          "type": "string"
        },
        "readiness_reason": {
          "type": "string"
        },
        "tool_name": {
          "type": "string"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "uri_prefix": {
          "type": "string",
          "pattern": "^skillrun://router/"
        },
        "issue": {
          "$ref": "#/$defs/issue"
        },
        "recommended_action": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
