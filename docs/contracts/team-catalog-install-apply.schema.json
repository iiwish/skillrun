{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillrun.local/schemas/team-catalog-install-apply.v1.schema.json",
  "title": "SkillRun Team Catalog install apply contract",
  "type": "object",
  "required": [
    "command",
    "schema_version",
    "ok",
    "catalog_id",
    "item_id",
    "download",
    "import",
    "next_steps",
    "warnings",
    "error"
  ],
  "properties": {
    "command": {
      "const": "team catalog install apply"
    },
    "schema_version": {
      "const": "team.catalog.install_apply.v1"
    },
    "ok": {
      "const": true
    },
    "catalog_id": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "download": {
      "type": "object",
      "required": ["source_type", "package_path", "sha256", "sha256_verified"],
      "properties": {
        "source_type": {
          "enum": ["file", "https"]
        },
        "package_path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "sha256_verified": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "import": {
      "type": "object",
      "required": ["schema_version", "id", "path", "source_type", "enabled", "replaced"],
      "properties": {
        "schema_version": {
          "const": "import.v1"
        },
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "source_type": {
          "const": "imported_skr"
        },
        "enabled": {
          "type": "boolean"
        },
        "replaced": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "error": {
      "type": "null"
    }
  },
  "$defs": {
    "warning": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
