{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillrun.local/schemas/team-catalog-inspect.v1.schema.json",
  "title": "SkillRun Team Catalog inspect contract",
  "type": "object",
  "required": ["command", "schema_version", "ok", "catalog", "items", "error"],
  "properties": {
    "command": {
      "const": "team catalog inspect"
    },
    "schema_version": {
      "const": "team.catalog.inspect.v1"
    },
    "ok": {
      "const": true
    },
    "catalog": {
      "type": "object",
      "required": ["catalog_id", "name", "updated_at", "items"],
      "properties": {
        "catalog_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": ["string", "null"]
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "homepage": {
          "type": ["string", "null"]
        },
        "items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "error": {
      "type": "null"
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "description",
        "version",
        "installable",
        "installed",
        "source_type",
        "warnings"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": ["skillrun.skr", "agent.skill", "mcp.server"]
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "installable": {
          "type": "boolean"
        },
        "installed": {
          "type": "boolean"
        },
        "source_type": {
          "enum": ["file", "https"]
        },
        "sha256": {
          "type": ["string", "null"]
        },
        "publisher": true,
        "homepage": {
          "type": ["string", "null"]
        },
        "repository": {
          "type": ["string", "null"]
        },
        "requirements": {
          "type": ["array", "null"]
        },
        "permissions_summary": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "mcp": true,
        "trust_note": {
          "type": ["string", "null"]
        },
        "tags": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        }
      },
      "additionalProperties": true
    },
    "warning": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
