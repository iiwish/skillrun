{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillrun.local/schemas/router-mcp.v1.schema.json",
  "title": "SkillRun Router MCP dry-run contract",
  "type": "object",
  "required": [
    "command",
    "schema_version",
    "ok",
    "mcp",
    "router",
    "tools",
    "resources",
    "routes",
    "issues"
  ],
  "properties": {
    "command": {
      "enum": ["router serve --mcp", "router serve --mcp --dry-run"]
    },
    "schema_version": {
      "const": "router.mcp.v1"
    },
    "ok": {
      "type": "boolean"
    },
    "mcp": {
      "type": "object",
      "required": ["dry_run", "transport", "protocol"],
      "properties": {
        "dry_run": {
          "const": true
        },
        "transport": {
          "const": "stdio"
        },
        "protocol": {
          "const": "model-context-protocol"
        }
      },
      "additionalProperties": true
    },
    "router": {
      "type": "object",
      "required": ["snapshot", "capsules"],
      "properties": {
        "snapshot": {
          "const": true
        },
        "capsules": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capsule_id",
          "capsule_path",
          "name",
          "description",
          "input_schema",
          "output_schema",
          "manifest_sha256",
          "result_contract"
        ],
        "properties": {
          "capsule_id": {
            "type": "string"
          },
          "capsule_path": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "input_schema": {
            "type": "object"
          },
          "output_schema": {
            "type": "object"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "result_contract": {
            "const": "SkillRun output/error envelope"
          }
        },
        "additionalProperties": true
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capsule_id", "uri", "name", "path", "mime_type"],
        "properties": {
          "capsule_id": {
            "type": "string"
          },
          "uri": {
            "type": "string",
            "pattern": "^skillrun://router/"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "mime_type": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "routes": {
      "type": "array",
      "description": "Per enabled-capsule Router diagnostics. Disabled capsules are intentionally omitted.",
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "issues": {
      "type": "array",
      "description": "Machine-readable warnings and errors for enabled capsules considered by the Router.",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "error": {
      "$ref": "#/$defs/error"
    }
  },
  "$defs": {
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "issue": {
      "type": "object",
      "required": ["code", "severity", "message", "recommended_action"],
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "enum": ["warning", "error"]
        },
        "message": {
          "type": "string"
        },
        "capsule_id": {
          "type": ["string", "null"]
        },
        "tool_name": {
          "type": ["string", "null"]
        },
        "recommended_action": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "route": {
      "type": "object",
      "required": [
        "capsule_id",
        "capsule_path",
        "enabled",
        "state",
        "readiness_status",
        "recommended_action"
      ],
      "properties": {
        "capsule_id": {
          "type": "string"
        },
        "capsule_path": {
          "type": "string"
        },
        "enabled": {
          "const": true
        },
        "state": {
          "enum": ["routable", "blocked"]
        },
        "readiness_status": {
          "type": "string"
        },
        "readiness_reason": {
          "type": "string"
        },
        "tool_name": {
          "type": "string"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "uri_prefix": {
          "type": "string",
          "pattern": "^skillrun://router/"
        },
        "issue": {
          "$ref": "#/$defs/issue"
        },
        "recommended_action": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
