{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillrun.local/schemas/team-catalog-install-plan.v1.schema.json",
  "title": "SkillRun Team Catalog install plan contract",
  "type": "object",
  "required": [
    "command",
    "schema_version",
    "ok",
    "catalog_id",
    "item",
    "registry",
    "actions",
    "warnings",
    "error"
  ],
  "properties": {
    "command": {
      "const": "team catalog install plan"
    },
    "schema_version": {
      "const": "team.catalog.install_plan.v1"
    },
    "ok": {
      "const": true
    },
    "catalog_id": {
      "type": "string"
    },
    "item": {
      "type": "object",
      "required": ["id", "kind", "version", "source_type", "sha256"],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "const": "skillrun.skr"
        },
        "version": {
          "type": "string"
        },
        "source_type": {
          "enum": ["file", "https"]
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "registry": {
      "type": "object",
      "required": ["installed", "source_type", "enabled", "path"],
      "properties": {
        "installed": {
          "type": "boolean"
        },
        "source_type": {
          "type": ["string", "null"]
        },
        "enabled": {
          "type": ["boolean", "null"]
        },
        "path": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "replace", "requires_confirmation"],
        "properties": {
          "type": {
            "const": "import"
          },
          "replace": {
            "type": "boolean"
          },
          "requires_confirmation": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "error": {
      "type": "null"
    }
  },
  "$defs": {
    "warning": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
