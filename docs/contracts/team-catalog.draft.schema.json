{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillrun.local/schemas/team-catalog.v1.draft.schema.json",
  "title": "SkillRun Team Catalog v1 draft",
  "description": "Draft schema for team catalog files. Not an implemented stable CLI contract.",
  "type": "object",
  "required": ["schema_version", "catalog_id", "name", "updated_at", "items"],
  "properties": {
    "schema_version": {
      "const": "team.catalog.v1"
    },
    "catalog_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "kind", "name", "description", "version", "source"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "kind": {
          "enum": ["skillrun.skr", "agent.skill", "mcp.server"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": true
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "permissions_summary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mcp": {
          "type": "object",
          "properties": {
            "exposes_tools": {
              "type": "boolean"
            },
            "mount": {
              "enum": ["skillrun-router", "external"]
            }
          },
          "additionalProperties": true
        },
        "trust_note": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["type", "url"],
      "properties": {
        "type": {
          "enum": ["file", "https"]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "https"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["sha256"]
          }
        }
      ],
      "additionalProperties": true
    },
    "requirement": {
      "type": "object",
      "required": ["kind", "summary"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
