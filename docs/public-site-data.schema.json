{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iiwish/skillrun/docs/public-site-data.schema.json",
  "title": "SkillRun public site data",
  "type": "object",
  "required": [
    "schema_version",
    "generated_from",
    "product",
    "release",
    "quickstart",
    "trust_boundaries",
    "team_distribution"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "skillrun.public_site.v1"
    },
    "generated_from": {
      "type": "object",
      "required": ["repo", "source_commit", "updated_at"],
      "additionalProperties": false,
      "properties": {
        "repo": { "type": "string", "format": "uri" },
        "source_commit": { "type": "string", "minLength": 7 },
        "updated_at": { "type": "string", "format": "date" }
      }
    },
    "product": {
      "type": "object",
      "required": ["name", "repo_url", "positioning"],
      "additionalProperties": false,
      "properties": {
        "name": { "const": "SkillRun" },
        "repo_url": { "type": "string", "format": "uri" },
        "positioning": { "type": "string", "minLength": 1 }
      }
    },
    "release": {
      "type": "object",
      "required": [
        "current_development_line",
        "latest_public_release",
        "version_command_output",
        "release_url",
        "latest_download_base_url",
        "installers",
        "assets",
        "current_capabilities"
      ],
      "additionalProperties": false,
      "properties": {
        "current_development_line": { "$ref": "#/$defs/release_tag" },
        "latest_public_release": { "$ref": "#/$defs/release_tag" },
        "version_command_output": { "type": "string", "pattern": "^skillrun [0-9]+\\.[0-9]+\\.[0-9]+$" },
        "release_url": { "type": "string", "format": "uri" },
        "latest_download_base_url": { "type": "string", "format": "uri" },
        "installers": {
          "type": "object",
          "required": ["shell", "powershell"],
          "additionalProperties": false,
          "properties": {
            "shell": { "$ref": "#/$defs/installer" },
            "powershell": { "$ref": "#/$defs/installer" }
          }
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "kind", "platform", "url", "digest"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["installer", "archive", "checksum"] },
              "platform": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri" },
              "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            }
          }
        },
        "current_capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "quickstart": {
      "type": "object",
      "required": ["author_commands", "consumer_commands", "router_commands"],
      "additionalProperties": false,
      "properties": {
        "author_commands": { "$ref": "#/$defs/commands" },
        "consumer_commands": { "$ref": "#/$defs/commands" },
        "router_commands": { "$ref": "#/$defs/commands" }
      }
    },
    "trust_boundaries": {
      "type": "object",
      "required": ["current", "not_promised"],
      "additionalProperties": false,
      "properties": {
        "current": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "not_promised": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "team_distribution": {
      "type": "object",
      "required": ["status", "summary", "boundaries"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["development_line", "released"] },
        "summary": { "type": "string", "minLength": 1 },
        "boundaries": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "release_tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "installer": {
      "type": "object",
      "required": ["label", "command"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
